// Version information and manifest for holo-sysaudio.exe (compiled with rc.exe, linked with /MANIFEST:NO).
#include <winver.h>

1 24 "holo-sysaudio.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "HoloVoice"
      VALUE "FileDescription", "HoloVoice computer sound helper"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "holo-sysaudio"
      VALUE "OriginalFilename", "holo-sysaudio.exe"
      VALUE "ProductName", "HoloVoice"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
